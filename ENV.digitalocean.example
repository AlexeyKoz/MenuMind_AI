# DigitalOcean Production Environment Variables
# Copy this to backend/.env on your DigitalOcean droplet and fill in your values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_NAME=menumine_ai
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432

# ============================================================================
# DJANGO SETTINGS
# ============================================================================
SECRET_KEY=CHANGE_THIS_TO_RANDOM_50_CHARACTER_STRING
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,your-droplet-ip

# Use PostgreSQL (required for production)
USE_POSTGRES=True

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ============================================================================
# FRONTEND URLS (Replace with your domain)
# ============================================================================
FRONTEND_API_URL=http://your-domain.com:8000
FRONTEND_WS_URL=ws://your-domain.com:8001

# Or if using IP address:
# FRONTEND_API_URL=http://YOUR_DROPLET_IP:8000
# FRONTEND_WS_URL=ws://YOUR_DROPLET_IP:8001

# ============================================================================
# CORS SETTINGS
# ============================================================================
CORS_ALLOWED_ORIGINS=http://your-domain.com,http://www.your-domain.com
CORS_ALLOW_ALL_ORIGINS=False

# ============================================================================
# GOOGLE OAUTH (Your existing credentials)
# ============================================================================
GOOGLE_CLIENT_ID=819829561375-19d74oa53gsn83r0qaaavb0659hsegqo.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================================================
# SENTRY ERROR TRACKING (Optional but recommended)
# ============================================================================
SENTRY_DSN=https://a286cf89396658abbc772704749dded4@o4510275117383680.ingest.de.sentry.io/4510275122823248
SENTRY_ENVIRONMENT=production

# ============================================================================
# AI SERVICES (If you have API keys)
# ============================================================================
OPENAI_API_KEY=your-openai-key
GEMINI_API_KEY=your-gemini-key

# ============================================================================
# EMAIL CONFIGURATION (Optional - for notifications)
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=MenuMine AI <noreply@your-domain.com>

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Set to True when you add HTTPS/SSL:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

